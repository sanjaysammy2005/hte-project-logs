# Copy to .env and change the password. .env is git-ignored; never commit it.
# Use only URL-safe characters in the password (letters, digits, - _ .),
# because it is embedded in the database connection URL.

POSTGRES_USER=tracelock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracelock

# Host ports (bound to 127.0.0.1 only). 5433 avoids clashing with a local PostgreSQL.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

APP_ENV=development

# Signs API access tokens. At least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-of-32-or-more-chars
ACCESS_TOKEN_MINUTES=30

# Tamper lab (mutates cloned lab streams only). Keep false outside a lab setting.
TRACELOCK_LAB_ENABLED=false

# File module. Maximum upload size in bytes (default 25 MiB) and the allowed extensions
# (comma-separated; each must have a content-validation rule in backend/app/files/validation.py).
TRACELOCK_MAX_UPLOAD_BYTES=26214400
TRACELOCK_ALLOWED_EXTENSIONS=txt,pdf,doc,docx,ppt,pptx,xls,xlsx,csv,jpg,jpeg,png
