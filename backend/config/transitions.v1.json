  "allowed": {
    "__START__": ["LOGIN"],
    "LOGIN": ["AUTHENTICATION", "LOGOUT"],
    "AUTHENTICATION": ["FILE_OPEN", "DB_ACCESS", "LOGOUT"],
    "FILE_OPEN": ["FILE_OPEN", "FILE_EDIT", "DB_ACCESS", "LOGOUT"],
    "FILE_EDIT": ["FILE_OPEN", "FILE_EDIT", "DB_ACCESS", "LOGOUT"],
    "DB_ACCESS": ["FILE_OPEN", "DB_ACCESS", "LOGOUT"],
    "LOGOUT": []
  }
}
